# Copy to .env for local development. Every value has a dev-safe default except
# JWT_SECRET and GEO_SERVICE_API_KEY.
DB_HOST=localhost
DB_PORT=5433
DB_USER=cryohealth
DB_PASSWORD=cryohealth-dev
DB_NAME=cryohealth
JWT_SECRET=generate-a-long-random-string
JWT_EXPIRES=12h
PORT=3000
# Comma-separated allowed origins for CORS (Expo web preview, browser clients).
# Native app fetch calls aren't CORS-restricted, so this doesn't gate the mobile app itself.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
# Shared secret CryoHealth-geo sends as the x-api-key header on
# POST /alerts/hazard-scores — min 32 chars, must match geo's CRYOHEALTH_API_KEY.
GEO_SERVICE_API_KEY=generate-a-long-random-string-min-32-chars
# Firebase Admin credentials — copy these three fields from the service-account JSON
# (project_id, client_email, private_key). Keep the private key on ONE line in double
# quotes, with the newlines written as literal \n. Required in production.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nPASTE_KEY_BODY\n-----END PRIVATE KEY-----\n"
