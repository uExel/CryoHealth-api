# Copy to .env for local development. Every value has a dev-safe default except
# JWT_SECRET and GEO_SERVICE_API_KEY.
DB_HOST=localhost
DB_PORT=5433
DB_USER=cryohealth
DB_PASSWORD=cryohealth-dev
DB_NAME=cryohealth
JWT_SECRET=generate-a-long-random-string
JWT_EXPIRES=12h
PORT=3000
# Comma-separated allowed origins for CORS (Expo web preview, browser clients).
# Native app fetch calls aren't CORS-restricted, so this doesn't gate the mobile app itself.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
# Shared secret CryoHealth-geo sends as the x-api-key header on
# POST /alerts/hazard-scores — min 32 chars, must match geo's CRYOHEALTH_API_KEY.
GEO_SERVICE_API_KEY=generate-a-long-random-string-min-32-chars
